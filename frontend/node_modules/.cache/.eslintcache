anagement-main\\DuLich\\frontend\\src\\share\\SearchBar.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\services\\ServiceList.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\services\\ServiceCard.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Featured-tours\\FeaturedTourList.jsx",["243"],[],"import React from 'react'\r\nimport TourCard from '../../share/TourCard'\r\nimport TourData from '../../assets/data/tours'\r\nimport { Col } from 'reactstrap'\r\nimport useFetch from '../../hooks/useFetch'\r\nimport { BASE_URL } from '../../utils/config'\r\n\r\nconst FeaturedTourList = () => {\r\n  const {data: featuredTours, loading, error} = useFetch(`${BASE_URL}/tours/search/getFeaturedTours`)\r\n\r\n  return (\r\n    <>\r\n      {\r\n        loading && <h4>Loading........</h4>\r\n      }\r\n      {\r\n        error && <h4>{error}</h4>\r\n      }\r\n        {!loading &&!error && featuredTours?.map(tour => (\r\n            <Col lg='3' md='6' sm='6' className=\"mb-4\" key={tour.id}>\r\n                <TourCard tour = {tour}/>\r\n            </Col>\r\n        ))}\r\n    </>\r\n  )\r\n}\r\n\r\nexport default FeaturedTourList\r\n","E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\share\\TourCard.jsx",["244"],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\assets\\data\\tours.js",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\utils\\avgRating.js",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Image-gallery\\ImageGalerry.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Image-gallery\\galleryImages.js",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Testimonial\\Testimonial.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\share\\Newsletter.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\share\\CommonSection.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Booking\\Booking.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\ThankYou.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\hooks\\useFetch.js",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\utils\\config.js",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\context\\AuthContext.js",["245"],[],"import { Children } from \"react\";\r\nimport { createContext, useEffect, useReducer } from \"react\";\r\n\r\nconst initial_state = {\r\n    user: localStorage.getItem('user') !== null ? JSON.parse(localStorage.getItem('user')): null,\r\n    loading: false,\r\n    error: null\r\n}\r\n\r\nexport const AuthContext = createContext(initial_state)\r\n\r\nconst AuthReducer = (state, action) => {\r\n    switch (action.type) {\r\n        case \"LOGIN_START\":\r\n            return {\r\n                user: null,\r\n                loading: true,\r\n                error: null\r\n            }\r\n        case \"LOGIN_SUCCESS\":\r\n            return {\r\n                user: action.payload,\r\n                loading: false,\r\n                error: null\r\n            };\r\n        case \"LOGIN_FAILURE\":\r\n            return {\r\n                user: null,\r\n                loading: false,\r\n                error: action.payload\r\n            }\r\n        case \"LOGOUT\":\r\n            return {\r\n                user: null,\r\n                loading: false,\r\n                error: null\r\n            } \r\n        default  :\r\n        return state\r\n    }\r\n}\r\n\r\nexport const AuthContextProvider = ({children})=>{\r\n    const [state, dispatch] = useReducer(AuthReducer, initial_state)\r\n\r\n    useEffect(()=>{\r\n        localStorage.setItem('user', JSON.stringify(state.user))\r\n    },[state.user])\r\n\r\n    return <AuthContext.Provider value={{\r\n        user:state.user,\r\n        loading:state.loading,\r\n        error:state.error,\r\n        dispatch\r\n    }}>\r\n        {children}\r\n    </AuthContext.Provider>\r\n}","E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Admin\\ManageTours.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Admin\\ManageUsers.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Admin\\ManageBookings.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\About.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\MyProfile.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Admin\\CreateTour.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Admin\\Dashboard.jsx",["246"],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Mybooking.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Voucher.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\PolicyFAQ.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\BookingDetail.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Admin\\ManageReviews.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Admin\\ManageBookingDetail.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Admin\\ManageFAQ.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Admin\\AdminLayout.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Admin\\AdminSidebar.jsx",["247"],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Booking\\BookingTimeline.jsx",[],[],{"ruleId":"248","severity":1,"message":"249","line":21,"column":9,"nodeType":"250","endLine":21,"endColumn":36},{"ruleId":"251","severity":1,"message":"252","line":21,"column":91,"nodeType":"253","messageId":"254","endLine":21,"endColumn":101,"fix":"