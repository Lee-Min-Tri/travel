":0,"usedDeprecatedRules":"99"},{"filePath":"173","messages":"174","suppressedMessages":"175","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"99"},{"filePath":"176","messages":"177","suppressedMessages":"178","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"179","messages":"180","suppressedMessages":"181","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"99"},{"filePath":"182","messages":"183","suppressedMessages":"184","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"185","messages":"186","suppressedMessages":"187","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"99"},{"filePath":"188","messages":"189","suppressedMessages":"190","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"191","usedDeprecatedRules":"99"},{"filePath":"192","messages":"193","suppressedMessages":"194","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"195","messages":"196","suppressedMessages":"197","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"198","messages":"199","suppressedMessages":"200","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"201","messages":"202","suppressedMessages":"203","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"204","messages":"205","suppressedMessages":"206","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"207","messages":"208","suppressedMessages":"209","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"210","messages":"211","suppressedMessages":"212","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"213"},{"filePath":"214","messages":"215","suppressedMessages":"216","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"217","messages":"218","suppressedMessages":"219","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"220","messages":"221","suppressedMessages":"222","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"223","messages":"224","suppressedMessages":"225","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"226","messages":"227","suppressedMessages":"228","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"229","messages":"230","suppressedMessages":"231","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"232","messages":"233","suppressedMessages":"234","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"235","messages":"236","suppressedMessages":"237","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"238","messages":"239","suppressedMessages":"240","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"241"},{"filePath":"242","messages":"243","suppressedMessages":"244","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\index.js",[],[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\App.js",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Layout\\Layout.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Header\\Header.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Footer\\Footer.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\router\\Router.js",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Tour.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\TourDetails.jsx",["245"],[],"import React, { useRef, useState, useEffect, useContext } from 'react'\r\nimport '../style/tour-detail.css'\r\nimport { Container, Row, Col, Form, ListGroup } from 'reactstrap'\r\nimport { useParams } from 'react-router-dom'\r\nimport caculateAvgRating from '../utils/avgRating'\r\nimport avatar from \"../assets/images/avatar.jpg\"\r\nimport Booking from '../components/Booking/Booking'\r\nimport Newsletter from '../share/Newsletter'\r\nimport useFetch from '../hooks/useFetch'\r\nimport { BASE_URL } from '../utils/config'\r\nimport { AuthContext } from '../context/AuthContext'\r\n\r\nconst TourDetails = () => {\r\n\r\n  const { id } = useParams()\r\n  const reviewMsgRef = useRef('')\r\n  const [tourRating, setTourRating] = useState(null)\r\n  const { user } = useContext(AuthContext)\r\n\r\n  const { data: result, loading, error } = useFetch(`${BASE_URL}/tours/${id}`)\r\n  const tour = result ? result : {};\r\n\r\n\r\n  const { photo, title, desc, price, address, reviews, city, distance, maxGroupSize, images, itinerary } = tour\r\n\r\n  const { totalRating, avgRating } = caculateAvgRating(reviews || [])\r\n  const totalSeatsAvailable = tour.tourDates?.reduce((sum, item) => sum + (Number(item.seatsAvailable) || 0), 0) || 0\r\n  const nextAvailableDate = tour.tourDates?.find(item => Number(item.seatsAvailable) > 0)\r\n  const nextAvailableSeats = nextAvailableDate ? Number(nextAvailableDate.seatsAvailable) : 0\r\n  const [selectedImg, setSelectedImg] = useState(null)\r\n\r\n  const options = { day: 'numeric', month: 'long', year: 'numeric' }\r\n  const submitHandler = async e => {\r\n    e.preventDefault()\r\n    const reviewText = reviewMsgRef.current.value\r\n    const token = localStorage.getItem('token')\r\n\r\n    try {\r\n      if (!user || user === undefined || user === null) {\r\n        alert('Bạn chưa đăng nhập')\r\n      }\r\n\r\n      const reviewObj = {\r\n        username: user?.username,\r\n        reviewText,\r\n        rating: tourRating\r\n      }\r\n      const res = await fetch(`${BASE_URL}/review/${id}`, {\r\n        method: 'post',\r\n        headers: {\r\n          'content-type': 'application/json',\r\n          'Authorization': `Bearer ${token}`\r\n        },\r\n        body: JSON.stringify(reviewObj)\r\n      })\r\n\r\n      const result = await res.json()\r\n      if (!res.ok) {\r\n        return alert(result.message)\r\n      }\r\n      alert(result.message)\r\n      window.location.reload()\r\n    } catch (err) {\r\n      alert(err.message)\r\n    }\r\n  }\r\n\r\n  useEffect(() => {\r\n    window.scrollTo(0, 0)\r\n    if (tour.photo) setSelectedImg(tour.photo)\r\n  }, [tour])\r\n\r\n  return <>\r\n    <section>\r\n      <Container>\r\n        {\r\n          loading && <h4 className='text-center pt-5'>Loading.......</h4>\r\n        }\r\n        {\r\n          error && <h4 className='text-center pt-5'>{error}</h4>\r\n        }\r\n        {\r\n          !loading && !error && <Row>\r\n            <Col lg='8'>\r\n              <div className=\"tour_content\">\r\n                <img src={`http://localhost:4000/static-number-one/${selectedImg || photo}`} alt=\"\" onClick={() => setSelectedImg(photo)}/>\r\n                <div className=\"tour__gallery d-flex gap-2 mt-3\">\r\n                  {images?.map((img, index) => (\r\n                    <img\r\n                      key={index}\r\n                      src={`http://localhost:4000/static-number-one/${img}`}\r\n                      alt=\"\"\r\n                      onClick={() => setSelectedImg(img)}\r\n                      style={{\r\n                        width: '100px',\r\n                        height: '80px',\r\n                        objectFit: 'cover',\r\n                        borderRadius: '5px',\r\n                        cursor: 'pointer',\r\n                        border: '1px solid #ccc'\r\n                      }}\r\n                    />\r\n                  ))}\r\n                </div>\r\n\r\n                <div className=\"tour_info\">\r\n                  <h2>{title}</h2>\r\n\r\n                  <div className='d-flex align-items-center gap-5'>\r\n                    <span className='tour_rating d-flex align-items-center gap-1'>\r\n                      <i class=\"ri-star-line\" style={{ color: \"var(--secondary-color)\" }}></i> {avgRating === 0 ? null : avgRating}\r\n                      {totalRating === 0 ? (\r\n                        \"Chưa có đánh giá\"\r\n                      ) : (\r\n                        <span>({reviews.length})</span>\r\n                      )}\r\n                    </span>\r\n\r\n                    <span>\r\n                      <i class=\"ri-map-pin-line\"></i>{address}\r\n                    </span>\r\n                  </div>\r\n\r\n                  <div className=\"tour_extra-details\">\r\n                    <span><i class=\"ri-road-map-line\"></i>{city}</span>\r\n                    <span><i class=\"ri-money-dollar-circle-line\"></i>{Number(price).toLocaleString('vi-VN')}đ/ 1 người</span>\r\n                    <span><i class=\"ri-route-line\"></i>{distance}km</span>\r\n                    <span><i class=\"ri-group-fill\"></i>{maxGroupSize} người</span>\r\n                    <span>\r\n                      <i className=\"ri-stack-line\"></i>\r\n                      {tour.tourDates?.length > 1\r\n                        ? `Ngày đầu tiên còn ${nextAvailableSeats} ghế`\r\n                        : `Số ghế trống: ${nextAvailableSeats}`}\r\n                    </span>\r\n                    {tour.tourDates?.length > 1 && (\r\n                      <span>\r\n                        <i className=\"ri-stack-line\"></i>\r\n                        Tổng còn {totalSeatsAvailable} ghế trên {tour.tourDates.length} đợt\r\n                      </span>\r\n                    )}\r\n                  </div>\r\n                  {tour.tourDates?.length > 0 && (\r\n                    <div className='tour_schedule mt-3'>\r\n                      <h6>Ngày khởi hành hiện có</h6>\r\n                      <ul className='list-unstyled'>\r\n                        {tour.tourDates.map((item, idx) => (\r\n                          <li key={idx}>\r\n                            {new Date(item.date).toLocaleDateString('vi-VN')} - {item.seatsAvailable > 0 ? `còn ${item.seatsAvailable} ghế` : 'Hết chỗ'}\r\n                          </li>\r\n                        ))}\r\n                      </ul>\r\n                    </div>\r\n                  )}\r\n                  <h5>Mô tả</h5>\r\n                  <p>{desc}</p>\r\n\r\n                  {itinerary?.length > 0 && (\r\n                    <div className=\"tour_itinerary mt-4\">\r\n                      <h5>Lịch trình chuyến đi</h5>\r\n                      <div className=\"itinerary_list mt-3\">\r\n                        {itinerary.map((item, index) => (\r\n                          <div key={index} className=\"itinerary_item mb-3 p-3 border rounded bg-light\">\r\n                            <div className=\"d-flex align-items-center justify-content-between mb-2\">\r\n                              <strong>Ngày {item.day || index + 1}</strong>\r\n                              {item.meals && <span className=\"badge\">Thực đơn: {item.meals}</span>}\r\n                            </div>\r\n                            <p className=\"mb-1\"><strong>Địa điểm:</strong> {item.location || 'Chưa xác định'}</p>\r\n                            <p className=\"mb-0\"><strong>Mô tả:</strong> {item.description || 'Chưa có mô tả'}</p>\r\n                          </div>\r\n                        ))}\r\n                      </div>\r\n                    </div>\r\n                  )}\r\n                </div>\r\n                {/*tour reviews*/}\r\n                <div className=\"tour_reviews mt-4\">\r\n                  <h4>Reviews ({reviews?.length} reviews)</h4>\r\n\r\n                  <Form onSubmit={submitHandler}>\r\n                    <div className='d-flex align-items-center gap-3 mt-4 rating_group'>\r\n                      <span onClick={() => setTourRating(1)}>1<i class=\"ri-star-fill\"></i></span>\r\n                      <span onClick={() => setTourRating(2)}>2<i class=\"ri-star-fill\"></i></span>\r\n                      <span onClick={() => setTourRating(3)}>3<i class=\"ri-star-fill\"></i></span>\r\n                      <span onClick={() => setTourRating(4)}>4<i class=\"ri-star-fill\"></i></span>\r\n                      <span onClick={() => setTourRating(5)}>5<i class=\"ri-star-fill\"></i></span>\r\n                    </div>\r\n\r\n                    <div className=\"review_input\">\r\n                      <input type=\"text\" ref={reviewMsgRef} placeholder='Chia sẻ suy nghĩ của bạn' required />\r\n                      <button className='btn primary_btn text-white' type='submit'>Đăng</button>\r\n                    </div>\r\n                  </Form>\r\n\r\n                  <ListGroup className='user_reviews'>\r\n                    {\r\n                      reviews?.map(review => (\r\n                        <div className=\"review_item\">\r\n                          <img src={avatar} alt=\"\" />\r\n\r\n                          <div className=\"w-100\">\r\n                            <div className='d-flex align-items-center justify-content-between'>\r\n                              <div>\r\n                                <h5>{review.username}</h5>\r\n                                <p>{new Date(review.createdAt).toLocaleDateString('vi-VN', options)}</p>\r\n                              </div>\r\n                              <span className='d-flex align-item-center'>{review.rating}<i class=\"ri-star-fill\"></i></span>\r\n                            </div>\r\n\r\n                            <h6>{review.reviewText}</h6>\r\n                          </div>\r\n                        </div>\r\n                      ))\r\n                    }\r\n                  </ListGroup>\r\n                </div>\r\n              </div>\r\n            </Col>\r\n\r\n            <Col lg='4'>\r\n              <Booking tour={tour} avgRating={avgRating} />\r\n            </Col>\r\n          </Row>\r\n        }\r\n      </Container>\r\n    </section>\r\n    <Newsletter />\r\n  </>\r\n}\r\n\r\nexport default TourDetails\r\n","E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Home.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Register.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\SearchListTour.jsx",["246"],[],"import React, { useState } from 'react'\r\nimport CommonSection from '../share/CommonSection'\r\nimport { Container, Row, Col } from 'reactstrap'\r\n\r\nimport { useLocation } from 'react-router-dom'\r\nimport TourCard from '../share/TourCard'\r\nimport Newsletter from '../share/Newsletter'\r\n\r\nconst SearchListTour = () => {\r\nconst location = useLocation()\r\n\r\nconst [data] = useState(location.state)\r\nconsole.log(data)\r\n\r\n  return <>\r\n    <CommonSection title={\"Tour phù hợp\"}/>\r\n    <section>\r\n      <Container>\r\n        <Row>\r\n          {\r\n            data.length === 0 ? (<h4 className='text-center'>Không tìm thấy tour</h4>) : (data ?.map(tour =>\r\n              <Col lg='3' className=\"mb-4\" key={tour._id}><TourCard tour = {tour}/></Col>)\r\n            )\r\n          }\r\n        </Row>\r\n      </Container>\r\n    </section>\r\n    <Newsletter/>\r\n  </>\r\n}\r\n\r\nexport default SearchListTour\r\n","E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Login.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\share\\Subtitle.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\share\\SearchBar.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\services\\ServiceList.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\services\\ServiceCard.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Featured-tours\\FeaturedTourList.jsx",["247"],[],"import React from 'react'\r\nimport TourCard from '../../share/TourCard'\r\nimport TourData from '../../assets/data/tours'\r\nimport { Col } from 'reactstrap'\r\nimport useFetch from '../../hooks/useFetch'\r\nimport { BASE_URL } from '../../utils/config'\r\n\r\nconst FeaturedTourList = () => {\r\n  const {data: featuredTours, loading, error} = useFetch(`${BASE_URL}/tours/search/getFeaturedTours`)\r\n\r\n  return (\r\n    <>\r\n      {\r\n        loading && <h4>Loading........</h4>\r\n      }\r\n      {\r\n        error && <h4>{error}</h4>\r\n      }\r\n        {!loading &&!error && featuredTours?.map(tour => (\r\n            <Col lg='3' md='6' sm='6' className=\"mb-4\" key={tour.id}>\r\n                <TourCard tour = {tour}/>\r\n            </Col>\r\n        ))}\r\n    </>\r\n  )\r\n}\r\n\r\nexport default FeaturedTourList\r\n","E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\share\\TourCard.jsx",["248"],[],"import React from 'react'\r\nimport { Link } from 'react-router-dom'\r\nimport { Card, CardBody } from \"reactstrap\"\r\nimport caculateAvgRating from '../utils/avgRating'\r\n\r\nimport \"./TourCard.css\"\r\nimport { BASE_URL } from '../utils/config'\r\n\r\nconst TourCard = ({ tour }) => {\r\n    const { _id, title, city, photo, price, featured, reviews } = tour\r\n\r\n    const {totalRating, avgRating} = caculateAvgRating(reviews)\r\n\r\n    return (\r\n        <div className='tour_card'>\r\n            <Card>\r\n                <div className=\"tour_img\">\r\n                    <img src={`http://localhost:4000/static-number-one/${photo}`} alt=\"tour_img\" />\r\n                    {featured && <span>Tour nổi bật</span>}\r\n                </div>\r\n\r\n                <CardBody>\r\n                    <div className=\"card_top d-flex align-items-center justify-content-between\">\r\n                        <span className='tour_location d-flex align-items-center gap-1'>\r\n                            <i class=\"ri-map-pin-line\"></i> {city}\r\n                        </span>\r\n                        <span className='tour_rating d-flex align-items-center gap-1'>\r\n                            <i class=\"ri-star-line\"></i> {avgRating === 0 ? null : avgRating}\r\n                            {totalRating === 0 ? (\r\n                                \"Chưa có đánh giá\"\r\n                            ) : (\r\n                                <span>({reviews.length})</span>\r\n                            )}\r\n                        </span>\r\n                    </div>\r\n\r\n                    <h5 className=\"tour_title\">\r\n                        <Link to={`/tour/${_id}`}>{title}</Link>\r\n                    </h5>\r\n\r\n                    <div className=\"card_bottom d-flex align-items-center justify-content-between mt-3\">\r\n                        <h5>{Number(price).toLocaleString('vi-VN')}đ <span>/1 người/</span></h5>\r\n\r\n                        <button className=\"btn booking_btn\">\r\n                            <Link to={`/tour/${_id}`}>Đặt ngay</Link>\r\n                        </button>\r\n                    </div>\r\n                </CardBody>\r\n            </Card>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default TourCard\r\n","E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\assets\\data\\tours.js",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\utils\\avgRating.js",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Image-gallery\\ImageGalerry.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Image-gallery\\galleryImages.js",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Testimonial\\Testimonial.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\share\\Newsletter.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\share\\CommonSection.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Booking\\Booking.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\ThankYou.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\hooks\\useFetch.js",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\utils\\config.js",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\context\\AuthContext.js",["249"],[],"import { Children } from \"react\";\r\nimport { createContext, useEffect, useReducer } from \"react\";\r\n\r\nconst initial_state = {\r\n    user: localStorage.getItem('user') !== null ? JSON.parse(localStorage.getItem('user')): null,\r\n    loading: false,\r\n    error: null\r\n}\r\n\r\nexport const AuthContext = createContext(initial_state)\r\n\r\nconst AuthReducer = (state, action) => {\r\n    switch (action.type) {\r\n        case \"LOGIN_START\":\r\n            return {\r\n                user: null,\r\n                loading: true,\r\n                error: null\r\n            }\r\n        case \"LOGIN_SUCCESS\":\r\n            return {\r\n                user: action.payload,\r\n                loading: false,\r\n                error: null\r\n            };\r\n        case \"LOGIN_FAILURE\":\r\n            return {\r\n                user: null,\r\n                loading: false,\r\n                error: action.payload\r\n            }\r\n        case \"LOGOUT\":\r\n            return {\r\n                user: null,\r\n                loading: false,\r\n                error: null\r\n            } \r\n        default  :\r\n        return state\r\n    }\r\n}\r\n\r\nexport const AuthContextProvider = ({children})=>{\r\n    const [state, dispatch] = useReducer(AuthReducer, initial_state)\r\n\r\n    useEffect(()=>{\r\n        localStorage.setItem('user', JSON.stringify(state.user))\r\n    },[state.user])\r\n\r\n    return <AuthContext.Provider value={{\r\n        user:state.user,\r\n        loading:state.loading,\r\n        error:state.error,\r\n        dispatch\r\n    }}>\r\n        {children}\r\n    </AuthContext.Provider>\r\n}","E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Admin\\ManageTours.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Admin\\ManageUsers.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Admin\\ManageBookings.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\About.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\MyProfile.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Admin\\CreateTour.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Admin\\Dashboard.jsx",["250"],[],"import React, { useState } from 'react';\r\nimport { Container, Row, Col, Table, Input, Button, FormGroup, Label } from 'reactstrap';\r\nimport useFetch from '../../hooks/useFetch';\r\nimport { BASE_URL } from '../../utils/config';\r\n\r\nconst Dashboard = () => {\r\n   const { data: bookings, loading, error } = useFetch(`${BASE_URL}/booking`);\r\n\r\n   const [startDate, setStartDate] = useState('');\r\n   const [endDate, setEndDate] = useState('');\r\n\r\n   const totalBookings = bookings?.length || 0;\r\n   const totalRevenue = bookings?.reduce((sum, item) => {\r\n      return item.status === 'Đã thanh toán' ? sum + (item.totalPrice || 0) : sum;\r\n   }, 0) || 0;\r\n   const canceledBookings = bookings?.filter(item => item.status === 'Đã hủy' || item.status === 'cancelled').length || 0;\r\n   const cancelRate = totalBookings ? Math.round((canceledBookings / totalBookings) * 100) : 0;\r\n\r\n   const filterBookingByDate = (booking) => {\r\n      if (!booking.bookingAt) return false;\r\n      if (!startDate && !endDate) return true;\r\n      const bookingTime = new Date(booking.bookingAt).setHours(0,0,0,0);\r\n      const fromTime = startDate ? new Date(startDate).setHours(0,0,0,0) : null;\r\n      const toTime = endDate ? new Date(endDate).setHours(23,59,59,999) : null;\r\n      if (fromTime !== null && bookingTime < fromTime) return false;\r\n      if (toTime !== null && bookingTime > toTime) return false;\r\n      return true;\r\n   };\r\n\r\n   const filteredBookings = bookings?.filter(filterBookingByDate) || [];\r\n   const filteredRevenue = filteredBookings?.reduce((sum, item) => {\r\n      return item.status === 'Đã thanh toán' ? sum + (item.totalPrice || 0) : sum;\r\n   }, 0) || 0;\r\n   const filteredCount = filteredBookings?.length || 0;\r\n   const filteredCanceled = filteredBookings?.filter(item => item.status === 'Đã hủy' || item.status === 'cancelled').length || 0;\r\n\r\n   const resetFilters = () => {\r\n      setStartDate('');\r\n      setEndDate('');\r\n   };\r\n\r\n   return (\r\n      <section className='mt-5 mb-5'>\r\n         <Container>\r\n            <Row>\r\n               <Col lg='12' className='mb-4'>\r\n                  <h2 className='text-primary fw-bold'>Bảng điều khiển Admin</h2>\r\n                  <p className='text-muted'>Tổng quan đơn hàng và doanh thu hệ thống.</p>\r\n               </Col>\r\n\r\n               <Col lg='4' md='6' className='mb-3'>\r\n                  <div className='p-4 bg-white rounded shadow-sm'>\r\n                     <h5 className='mb-3'>Tổng booking</h5>\r\n                     <h3>{totalBookings}</h3>\r\n                  </div>\r\n               </Col>\r\n               <Col lg='4' md='6' className='mb-3'>\r\n                  <div className='p-4 bg-white rounded shadow-sm'>\r\n                     <h5 className='mb-3'>Doanh thu</h5>\r\n                     <h3>{totalRevenue.toLocaleString('vi-VN')} đ</h3>\r\n                  </div>\r\n               </Col>\r\n               <Col lg='12' className='mb-4'>\r\n                  <div className='bg-white rounded shadow-sm p-4'>\r\n                     <h5 className='mb-4'>Lọc doanh thu theo ngày/tháng/năm</h5>\r\n                     <Row className='align-items-end gy-3'>\r\n                        <Col md='4'>\r\n                           <FormGroup>\r\n                              <Label for='startDate'>Từ ngày</Label>\r\n                              <Input\r\n                                 type='date'\r\n                                 id='startDate'\r\n                                 value={startDate}\r\n                                 onChange={(e) => setStartDate(e.target.value)}\r\n                              />\r\n                           </FormGroup>\r\n                        </Col>\r\n                        <Col md='4'>\r\n                           <FormGroup>\r\n                              <Label for='endDate'>Đến ngày</Label>\r\n                              <Input\r\n                                 type='date'\r\n                                 id='endDate'\r\n                                 value={endDate}\r\n                                 onChange={(e) => setEndDate(e.target.value)}\r\n                              />\r\n                           </FormGroup>\r\n                        </Col>\r\n                        <Col md='4' className='d-flex gap-2'>\r\n                           <Button color='primary' onClick={resetFilters}>Xóa lọc</Button>\r\n                        </Col>\r\n                     </Row>\r\n\r\n                     <Row className='mt-4'>\r\n                        <Col md='4' className='mb-3'>\r\n                           <div className='p-3 bg-light rounded'>\r\n                              <h6>Tổng booking</h6>\r\n                              <p className='fs-4 mb-0'>{filteredCount}</p>\r\n                           </div>\r\n                        </Col>\r\n                        <Col md='4' className='mb-3'>\r\n                           <div className='p-3 bg-light rounded'>\r\n                              <h6>Doanh thu</h6>\r\n                              <p className='fs-4 mb-0'>{filteredRevenue.toLocaleString('vi-VN')} đ</p>\r\n                           </div>\r\n                        </Col>\r\n                        <Col md='4' className='mb-3'>\r\n                           <div className='p-3 bg-light rounded'>\r\n                              <h6>Hủy đặt</h6>\r\n                              <p className='fs-4 mb-0'>{filteredCanceled}</p>\r\n                           </div>\r\n                        </Col>\r\n                     </Row>\r\n                  </div>\r\n               </Col>\r\n\r\n               <Col lg='12' className='mt-4'>\r\n                  <div className='bg-white rounded shadow-sm p-4'>\r\n                     <h5 className='mb-4'>Danh sách booking mới</h5>\r\n                     <Table striped responsive>\r\n                        <thead>\r\n                           <tr>\r\n                              <th>Người đặt</th>\r\n                              <th>Tour</th>\r\n                              <th>Ngày</th>\r\n                              <th>Giá</th>\r\n                              <th>Trạng thái</th>\r\n                           </tr>\r\n                        </thead>\r\n                        <tbody>\r\n                           {loading && (\r\n                              <tr>\r\n                                 <td colSpan='5'>Đang tải dữ liệu...</td>\r\n                              </tr>\r\n                           )}\r\n                           {error && (\r\n                              <tr>\r\n                                 <td colSpan='5' className='text-danger'>{error}</td>\r\n                              </tr>\r\n                           )}\r\n                           {!loading && !error && bookings?.map(item => (\r\n                              <tr key={item._id}>\r\n                                 <td>{item.fullName || 'N/A'}</td>\r\n                                 <td>{item.tourName || 'N/A'}</td>\r\n                                 <td>{item.bookingAt ? new Date(item.bookingAt).toLocaleDateString('vi-VN') : 'N/A'}</td>\r\n                                 <td>{Number(item.totalPrice || 0).toLocaleString('vi-VN')} đ</td>\r\n                                 <td>{item.status || 'Chưa xử lý'}</td>\r\n                              </tr>\r\n                           ))}\r\n                        </tbody>\r\n                     </Table>\r\n                  </div>\r\n               </Col>\r\n            </Row>\r\n         </Container>\r\n      </section>\r\n   );\r\n};\r\n\r\nexport default Dashboard;\r\n","E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Mybooking.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Voucher.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\PolicyFAQ.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\BookingDetail.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Admin\\ManageReviews.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Admin\\ManageBookingDetail.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\pages\\Admin\\ManageFAQ.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Admin\\AdminLayout.jsx",[],[],"E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Admin\\AdminSidebar.jsx",["251"],[],"import React from 'react'\r\nimport { Link } from 'react-router-dom'\r\nimport { ListGroup, ListGroupItem } from 'reactstrap'\r\nimport './admin-sidebar.css'\r\n\r\nconst AdminSidebar = ({ currentUser }) => {\r\n  const isAdmin = currentUser?.role === 'admin'\r\n  const isStaff = currentUser?.role === 'nhân viên'\r\n\r\n  return (\r\n    <div className='admin_sidebar_menu'>\r\n      <div className='admin_logo p-3 text-center'>\r\n        <h5 className='fw-bold text-primary'>ADMIN PANEL</h5>\r\n      </div>\r\n\r\n      <ListGroup flush className='mt-3'>\r\n        {isAdmin && (\r\n          <ListGroupItem className='border-0'>\r\n            <Link to='/admin/dashboard' className='text-decoration-none text-dark d-flex align-items-center gap-2'>\r\n              <i className='ri-dashboard-line'></i> Thống kê doanh thu\r\n            </Link>\r\n          </ListGroupItem>\r\n        )}\r\n\r\n        <ListGroupItem className='border-0'>\r\n          <Link to='/admin/tours' className='text-decoration-none text-dark d-flex align-items-center gap-2'>\r\n            <i className='ri-map-pin-user-line'></i> Quản lý Tour\r\n          </Link>\r\n        </ListGroupItem>\r\n        <ListGroupItem className='border-0'>\r\n          <Link to='/admin/tours/create' className='text-decoration-none text-dark d-flex align-items-center gap-2'>\r\n            <i className='ri-add-circle-line'></i> Thêm Tour mới\r\n          </Link>\r\n        </ListGroupItem>\r\n        <ListGroupItem className='border-0'>\r\n          <Link to='/admin/bookings' className='text-decoration-none text-dark d-flex align-items-center gap-2'>\r\n            <i className='ri-shopping-cart-2-line'></i> Quản lý Booking\r\n          </Link>\r\n        </ListGroupItem>\r\n        <ListGroupItem className='border-0'>\r\n          <Link to='/admin/faqs' className='text-decoration-none text-dark d-flex align-items-center gap-2'>\r\n            <i className='ri-file-list-3-line'></i> Quản lý FAQ\r\n          </Link>\r\n        </ListGroupItem>\r\n        <ListGroupItem className='border-0'>\r\n          <Link to='/admin/reviews' className='text-decoration-none text-dark d-flex align-items-center gap-2'>\r\n            <i className='ri-star-line'></i> Quản lý Đánh giá\r\n          </Link>\r\n        </ListGroupItem>\r\n        {isAdmin && (\r\n          <ListGroupItem className='border-0'>\r\n            <Link to='/admin/users' className='text-decoration-none text-dark d-flex align-items-center gap-2'>\r\n              <i className='ri-user-settings-line'></i> Quản lý User\r\n            </Link>\r\n          </ListGroupItem>\r\n        )}\r\n      </ListGroup>\r\n\r\n      <div className='sidebar_footer p-3'>\r\n        <Link to='/home' className='text-decoration-none text-danger d-flex align-items-center gap-2'>\r\n          <i className='ri-home-4-line'></i> Quay lại trang chủ\r\n        </Link>\r\n      </div>\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default AdminSidebar\r\n","E:\\MernStack-Tour-Management-main\\DuLich\\frontend\\src\\components\\Booking\\BookingTimeline.jsx",[],[],{"ruleId":"252","severity":1,"message":"253","line":21,"column":9,"nodeType":"254","endLine":21,"endColumn":36},{"ruleId":"255","severity":1,"message":"256","line":21,"column":91,"nodeType":"257","messageId":"258","endLine":21,"endColumn":101,"fix":"259"},{"ruleId":"260","severity":1,"message":"261","line":3,"column":8,"nodeType":"262","messageId":"263","endLine":3,"endColumn":16},{"ruleId":"260","severity":1,"message":"264","line":7,"column":10,"nodeType":"262","messageId":"263","endLine":7,"endColumn":18},{"ruleId":"260","severity":1,"message":"265","line":1,"column":10,"nodeType":"262","messageId":"263","endLine":1,"endColumn":18},{"ruleId":"260","severity":1,"message":"266","line":17,"column":10,"nodeType":"262","messageId":"263","endLine":17,"endColumn":20},{"ruleId":"260","severity":1,"message":"267","line":8,"column":9,"nodeType":"262","messageId":"263","endLine":8,"endColumn":16},"react-hooks/exhaustive-deps","The 'tour' conditional could